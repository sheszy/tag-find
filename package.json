{
  "name": "locatelly",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron .",
    "desktop:build:win": "node scripts/require-app-url.cjs desktop && electron-builder --config electron-builder.config.cjs --win nsis",
    "desktop:build:mac": "node scripts/require-app-url.cjs desktop && electron-builder --config electron-builder.config.cjs --mac dmg",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "node scripts/require-app-url.cjs mobile && cap sync",
    "mobile:android:apk": "node scripts/require-app-url.cjs mobile && cap sync android && cd android && gradlew.bat assembleDebug",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/ios": "^8.6.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.2"
  },
  "main": "electron/main.cjs"
}
